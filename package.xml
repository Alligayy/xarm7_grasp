<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>xarm7_grasp</name>
  <version>0.0.0</version>
  <description>xArm-7 vision-tactile grasping system: grasp policy execution, hand-eye calibration (ArUco/ChArUco) and Xela tactile force-feedback grasping on ROS 2.</description>
  <maintainer email="gao@todo.todo">gao</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>xela_server_ros2</exec_depend>
  <exec_depend>xarm_msgs</exec_depend>
  <exec_depend>xarm_planner</exec_depend>
  <exec_depend>xarm_moveit_config</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
